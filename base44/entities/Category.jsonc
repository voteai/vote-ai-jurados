{
  "name": "Category",
  "type": "object",
  "properties": {
    "contest_id": {
      "type": "string",
      "description": "ID do concurso"
    },
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da categoria"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "contest_id",
    "name"
  ]
}